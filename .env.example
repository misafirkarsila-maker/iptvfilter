# ---- Uygulama ----
# HOST_PORT=8080 # Host üzerinde yayınlanacak port (Varsayılan: 8080)
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- Veritabanı ----
# SQLite dosyasının (data klasörü içinde) yolu
DATABASE_URL=sqlite:////app/data/app.db

# ---- Xtream API Hesabı (IPTV Oynatıcıları İçin) ----
# IPTV uygulamanıza (TiviMate, Smarters vb.) girilecek kullanıcı adı (Varsayılan: myuser)
API_USER=myuser

# API Şifresi: Boş bırakırsanız ilk çalıştırmada otomatik ve güvenli bir şifre üretilir,
# web panelinde kopyalanabilir olarak gösterilir ve istendiğinde yenilenebilir.
# API_PASSWORD=

# ---- Web Panel Erişimi ----
# Panel şifresi: Boş bırakılırsa ilk açılışta web arayüzünden (/setup) belirlenebilir
# veya isteyenler tek tıkla şifresiz kullanabilir.
# PANEL_PASSWORD=

# ---- Şifreleme Anahtarı (ENCRYPTION_KEY) ----
# Sağlayıcı hesap şifreleri bu anahtarla şifrelenir.
# Boş bırakırsanız sistem güçlü bir AES-256 Fernet anahtarını otomatik üretir,
# hem data/ dizinine hem de buraya güvenle kaydeder.
# ENCRYPTION_KEY=

# ---- Otomatik Senkronizasyon (Cron ifadesi, sunucu saat dilimi) ----
SYNC_CRON=0 3 * * *

# ---- Günlük (Log) ----
LOG_LEVEL=INFO
